# Convex (required)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_SITE_URL=

# App URL (set after deploy or custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email sender domain (MailerSend must verify this domain)
EMAIL_DOMAIN=your-domain.dpdns.org
EMAIL_FEEDBACK=feedback@your-domain.dpdns.org
EMAIL_CONTRIBUTOR=contributor@your-domain.dpdns.org
EMAIL_DONATIONS=donations@your-domain.dpdns.org
ENABLE_EMAIL=true

# Optional integrations
MAILERSEND_API_KEY=
STRIPE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
